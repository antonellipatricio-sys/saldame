rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App privada: solo el dueño. El chequeo de email en App.tsx es solo de UI;
    // la protección real es esta (cualquiera podría crearse un usuario en Auth).
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'antonellipatricio@gmail.com';
    }

    // Módulo público de gastos compartidos: sin login.
    match /sharedGroups/{document} {
      allow read, write: if true;
    }

    // Todo lo demás (expenses, categories, tags, responsables, cobros, ...)
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
